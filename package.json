{
  "name": "benaton",
  "version": "0.0.0",
  "author": "Masahiko Sakakibara<sakakibara@rdlabo.jp>",
  "description": "西宮・夙川のフレンチレストラン「ル ベナトン」のWebサイト",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prebuild": "npx @rdlabo/ionic-angular-collect-icons",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "serve:ssr:benaton": "node dist/benaton/server/server.mjs",
    "prepare": "husky",
    "fmt": "prettier --parser typescript --write \"./src/**/*.ts\" &&  prettier --parser angular --write \"./src/**/*.html\"",
    "lint": "ng lint"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@ionic/angular": "^9.0.0",
    "express": "^4.18.2",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@rdlabo/ionic-angular-collect-icons": "^3.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.9.1",
    "husky": "^9.0.11",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --parser typescript --write",
      "git add"
    ],
    "*.html": [
      "prettier --parser angular --write",
      "git add"
    ]
  }
}
