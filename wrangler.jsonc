{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benaton",
  "account_id": "57bafd0e2348b266e72e821f03157b41",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/benaton/browser",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "benaton.net", "custom_domain": true },
    { "pattern": "www.benaton.net", "custom_domain": true }
  ]
}
